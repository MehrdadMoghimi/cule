+// SFINAE-friendly variant of std::tuple_size: evaluates to an invalid size
+// instead of a hard error when T is not tuple-like (needed for GCC >= 9,
+// where std::tuple_size<T> on a non-tuple T is an incomplete type error
+// inside these operators' enable_if constraints)
+template<class T, class = void>
+struct facade_tuple_size : std::integral_constant<std::size_t, std::size_t(-1)> {};
+
+template<class T>
+struct facade_tuple_size<T, typename std::enable_if<(sizeof(std::tuple_size<T>) > 0)>::type>
+  : std::tuple_size<T>
+{};
+
+
 template<class T>
 struct is_arithmetic_tuple : std::is_base_of<arithmetic_tuple_facade<T>, T> {};
 
